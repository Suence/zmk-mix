#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

/ {
    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <0 11 54 53>;
        };
    };

    behaviors {
        encoder_sc: encoder_sc {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODER_SC";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <40>;
        };

        ONLY_HOLD_TAP: ONLY_HOLD_TAP {
            compatible = "zmk,behavior-hold-tap";
            label = "ONLY_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
        };

        L_HRM: L_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 55 56 57 58 59 54>;
            hold-trigger-on-release;
        };

        R_HRM: R_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "R_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&none  &none              &none              &none                  &none                &none      &none            &none                 &none                   &none               &none                       &none
&none  &kp Q              &kp W              &kp E                  &kp R                &kp T      &kp Y            &kp U                 &kp I                   &kp O               &kp P                       &none
&none  &L_HRM LEFT_GUI A  &L_HRM LEFT_ALT S  &L_HRM LEFT_CONTROL D  &L_HRM LEFT_SHIFT F  &kp G      &kp H            &R_HRM RIGHT_SHIFT J  &R_HRM RIGHT_CONTROL K  &R_HRM RIGHT_ALT L  &R_HRM RIGHT_GUI SEMICOLON  &none
&none  &kp Z              &kp X              &kp C                  &kp V                &kp B      &kp N            &kp M                 &kp COMMA               &kp DOT             &kp FSLH                    &none
&none  &none              &none              &lt 3 ESC              &lt 4 SPACE          &lt 5 TAB  &lt 6 BACKSPACE  &lt 7 ENTER           &lt 8 DELETE            &none               &none                       &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&encoder_sc SCRL_UP SCRL_DOWN>;
        };

        Extra {
            display-name = "Extra";
            bindings = <
&none  &none              &none              &none                  &none                &none      &none            &none                 &none                   &none               &none                       &none
&none  &kp Q              &kp W              &kp E                  &kp R                &kp T      &kp Y            &kp U                 &kp I                   &kp O               &kp P                       &none
&none  &L_HRM LEFT_GUI A  &L_HRM LEFT_ALT S  &L_HRM LEFT_CONTROL D  &L_HRM LEFT_SHIFT F  &kp G      &kp H            &R_HRM RIGHT_SHIFT J  &R_HRM RIGHT_CONTROL K  &R_HRM RIGHT_ALT L  &R_HRM RIGHT_GUI SEMICOLON  &none
&none  &kp Z              &kp X              &kp C                  &kp V                &kp B      &kp N            &kp M                 &kp COMMA               &kp DOT             &kp FSLH                    &none
&none  &none              &none              &lt 3 ESC              &lt 4 SPACE          &lt 5 TAB  &lt 6 BACKSPACE  &lt 7 ENTER           &lt 8 DELETE            &none               &none                       &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&encoder_sc SCRL_UP SCRL_DOWN>;
        };

        Tap {
            display-name = "Tap";
            bindings = <
&kp EQUAL         &kp N1  &kp N2        &kp N3     &kp NUMBER_4  &kp N5     &kp NUMBER_6     &kp N7       &kp N8        &kp N9         &kp N0         &kp MINUS
&kp TAB           &kp Q   &kp W         &kp E      &kp R         &kp T      &kp Y            &kp U        &kp I         &kp O          &kp P          &kp NON_US_BACKSLASH
&kp LEFT_CONTROL  &kp A   &kp S         &kp D      &kp F         &kp G      &kp H            &kp J        &kp K         &kp L          &kp SEMICOLON  &ONLY_HOLD_TAP RIGHT_CONTROL APOS
&kp LSHFT         &kp Z   &kp X         &kp C      &kp V         &kp B      &kp N            &kp M        &kp COMMA     &kp DOT        &kp FSLH       &kp RSHFT
&none             &none   &kp LEFT_ALT  &lt 3 ESC  &lt 4 SPACE   &lt 5 TAB  &lt 6 BACKSPACE  &lt 7 ENTER  &lt 8 DELETE  &kp RIGHT_ALT  &none          &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&encoder_sc SCRL_UP SCRL_DOWN>;
        };

        Fun {
            display-name = "Fun";
            bindings = <
&none  &none         &none         &none             &none           &none  &none            &none      &none               &none   &none    &none
&none  &bootloader   &to 2         &to 1             &to 0           &none  &kp PRINTSCREEN  &kp F7     &kp F8              &kp F9  &kp F12  &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &kp SCROLLLOCK   &kp F4     &kp F5              &kp F6  &kp F11  &none
&none  &none         &none         &none             &none           &none  &kp PAUSE_BREAK  &kp F1     &kp F2              &kp F3  &kp F10  &none
&none  &none         &none         &none             &none           &none  &kp BACKSPACE    &kp ENTER  &kp K_CONTEXT_MENU  &none   &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Num {
            display-name = "Num";
            bindings = <
&trans  &trans        &trans        &trans     &trans          &trans  &trans            &trans        &trans        &trans        &trans             &trans
&trans  &bootloader   &to 2         &to 1      &to 0           &trans  &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET  &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &kp EQUAL         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SEMICOLON      &trans
&trans  &trans        &trans        &trans     &trans          &trans  &kp BACKSLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp GRAVE          &trans
&trans  &trans        &trans        &trans     &trans          &trans  &kp MINUS         &kp NUMBER_0  &kp DOT       &trans        &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN>;
        };

        Sym {
            display-name = "Sym";
            bindings = <
&trans  &trans        &trans        &trans     &trans          &trans  &trans          &trans                &trans                 &trans                &trans           &trans
&trans  &bootloader   &to 2         &to 1      &to 0           &trans  &kp LEFT_BRACE  &kp AMPERSAND         &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE  &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &kp PLUS        &kp DOLLAR            &kp PERCENT            &kp CARET             &kp COLON        &trans
&trans  &trans        &trans        &trans     &trans          &trans  &kp PIPE        &kp EXCLAMATION       &kp AT_SIGN            &kp HASH              &kp TILDE        &trans
&trans  &trans        &trans        &trans     &trans          &trans  &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans          &trans        &trans          &trans           &trans         &trans  &trans           &trans     &trans         &trans         &trans
&trans  &kp C_AC_UNDO   &kp C_AC_CUT  &kp C_AC_COPY   &kp C_AC_PASTE   &kp C_AC_REDO  &trans  &to 0            &to 1      &to 2          &bootloader    &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans         &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans         &trans  &trans           &trans     &trans         &trans         &trans
&trans  &trans          &trans        &mkp MCLK       &mkp LCLK        &mkp RCLK      &trans  &trans           &trans     &trans         &trans         &trans
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
&trans  &trans          &trans        &trans          &trans           &trans         &trans  &trans           &trans     &trans         &trans         &trans
&trans  &kp C_AC_UNDO   &kp C_AC_CUT  &kp C_AC_COPY   &kp C_AC_PASTE   &kp C_AC_REDO  &trans  &to 0            &to 1      &to 2          &bootloader    &trans
&trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp CAPSLOCK   &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &kp END         &kp PAGE_UP   &kp PAGE_DOWN   &kp HOME         &kp INSERT     &trans  &trans           &trans     &trans         &trans         &trans
&trans  &trans          &trans        &trans          &trans           &trans         &trans  &trans           &trans     &trans         &trans         &trans
            >;
        };

        Media {
            display-name = "Media";
            bindings = <
&trans  &trans           &trans             &trans           &trans           &trans             &trans  &trans           &trans     &trans         &trans         &trans
&trans  &rgb_ug RGB_BRI  &rgb_ug RGB_SAI    &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG    &trans  &to 0            &to 1      &to 2          &bootloader    &trans
&trans  &kp C_PREV       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &ext_power EP_TOG  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &bt BT_CLR_ALL   &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2     &out OUT_TOG       &trans  &trans           &trans     &trans         &trans         &trans
&trans  &trans           &trans             &kp K_MUTE       &kp C_PP         &kp C_STOP         &trans  &trans           &trans     &trans         &trans         &trans
            >;
        };
    };
};

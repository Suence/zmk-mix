#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        encoder_sc: encoder_sc {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODER_SC";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <40>;
        };

        ONLY_HOLD_TAP: ONLY_HOLD_TAP {
            compatible = "zmk,behavior-hold-tap";
            label = "ONLY_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
        };

        L_HRM: L_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 55 56 57 58 59 54>;
            hold-trigger-on-release;
        };

        R_HRM: R_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "R_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&none  &none              &none              &none                  &none                &none      &none            &none                 &none                   &none               &none                       &none
&none  &kp Q              &kp W              &kp E                  &kp R                &kp T      &kp Y            &kp U                 &kp I                   &kp O               &kp P                       &none
&none  &L_HRM LEFT_GUI A  &L_HRM LEFT_ALT S  &L_HRM LEFT_CONTROL D  &L_HRM LEFT_SHIFT F  &kp G      &kp H            &R_HRM RIGHT_SHIFT J  &R_HRM RIGHT_CONTROL K  &R_HRM RIGHT_ALT L  &R_HRM RIGHT_GUI SEMICOLON  &none
&none  &kp Z              &kp X              &kp C                  &kp V                &kp B      &kp N            &kp M                 &kp COMMA               &kp DOT             &kp FSLH                    &none
&none  &none              &none              &lt 3 ESC              &lt 4 SPACE          &lt 5 TAB  &lt 6 BACKSPACE  &lt 7 ENTER           &lt 8 DELETE            &none               &none                       &none
            >;
        };

        Extra {
            display-name = "Extra";
            bindings = <
&none  &none              &none              &none                  &none                &none      &none            &none                 &none                   &none               &none                       &none
&none  &kp Q              &kp W              &kp E                  &kp R                &kp T      &kp Y            &kp U                 &kp I                   &kp O               &kp P                       &none
&none  &L_HRM LEFT_GUI A  &L_HRM LEFT_ALT S  &L_HRM LEFT_CONTROL D  &L_HRM LEFT_SHIFT F  &kp G      &kp H            &R_HRM RIGHT_SHIFT J  &R_HRM RIGHT_CONTROL K  &R_HRM RIGHT_ALT L  &R_HRM RIGHT_GUI SEMICOLON  &none
&none  &kp Z              &kp X              &kp C                  &kp V                &kp B      &kp N            &kp M                 &kp COMMA               &kp DOT             &kp FSLH                    &none
&none  &none              &none              &lt 3 ESC              &lt 4 SPACE          &lt 5 TAB  &lt 6 BACKSPACE  &lt 7 ENTER           &lt 8 DELETE            &none               &none                       &none
            >;
        };

        Tap {
            display-name = "Tap";
            bindings = <
&kp EQUAL         &kp N1  &kp N2        &kp N3     &kp NUMBER_4  &kp N5     &kp NUMBER_6     &kp N7       &kp N8        &kp N9         &kp N0         &kp MINUS
&kp TAB           &kp Q   &kp W         &kp E      &kp R         &kp T      &kp Y            &kp U        &kp I         &kp O          &kp P          &kp NON_US_BACKSLASH
&kp LEFT_CONTROL  &kp A   &kp S         &kp D      &kp F         &kp G      &kp H            &kp J        &kp K         &kp L          &kp SEMICOLON  &ONLY_HOLD_TAP RIGHT_CONTROL APOS
&kp LSHFT         &kp Z   &kp X         &kp C      &kp V         &kp B      &kp N            &kp M        &kp COMMA     &kp DOT        &kp FSLH       &kp RSHFT
&none             &none   &kp LEFT_ALT  &lt 3 ESC  &lt 4 SPACE   &lt 5 TAB  &lt 6 BACKSPACE  &lt 7 ENTER  &lt 8 DELETE  &kp RIGHT_ALT  &none          &none
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
&none  &none         &none         &none             &none           &none  &none            &none      &none               &none   &none    &none
&none  &bootloader   &to 2         &to 1             &to 0           &none  &kp PRINTSCREEN  &kp F7     &kp F8              &kp F9  &kp F12  &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &kp SCROLLLOCK   &kp F4     &kp F5              &kp F6  &kp F11  &none
&none  &none         &none         &none             &none           &none  &kp PAUSE_BREAK  &kp F1     &kp F2              &kp F3  &kp F10  &none
&none  &none         &none         &none             &none           &none  &kp BACKSPACE    &kp ENTER  &kp K_CONTEXT_MENU  &none   &none    &none
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
&none  &none         &none         &none      &none           &none  &none             &none         &none         &none         &none              &none
&none  &bootloader   &to 2         &to 1      &to 0           &none  &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET  &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none  &kp EQUAL         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SQT            &none
&none  &none         &none         &none      &none           &none  &kp BACKSLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp GRAVE          &none
&none  &none         &none         &none      &none           &none  &kp MINUS         &kp NUMBER_0  &kp DOT       &none         &none              &none
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
&none  &none         &none         &none      &none           &none  &none           &none                 &none                  &none                 &none              &none
&none  &bootloader   &to 2         &to 1      &to 0           &none  &kp LEFT_BRACE  &kp AMPERSAND         &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE    &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none  &kp PLUS        &kp DOLLAR            &kp PERCENT            &kp CARET             &kp DOUBLE_QUOTES  &none
&none  &none         &none         &none      &none           &none  &kp PIPE        &kp EXCLAMATION       &kp AT_SIGN            &kp HASH              &kp TILDE          &none
&none  &none         &none         &none      &none           &none  &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none                 &none              &none
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
&none  &none           &none           &none            &none           &none            &none  &none            &none      &none          &none          &none
&none  &none           &mmv MOVE_UP    &none            &kp C_AC_REDO   &msc SCRL_UP     &none  &to 0            &to 1      &to 2          &bootloader    &none
&none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_LEFT  &msc SCRL_RIGHT  &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &none
&none  &kp C_AC_UNDO   &kp C_AC_CUT    &kp C_AC_COPY    &kp C_AC_PASTE  &msc SCRL_DOWN   &none  &none            &none      &none          &none          &none
&none  &none           &none           &mkp MCLK        &mkp LCLK       &mkp RCLK        &none  &none            &none      &none          &none          &none
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
&none  &none           &none           &none          &none           &none          &none  &none            &none      &none          &none          &none
&none  &kp CAPSLOCK    &kp UP_ARROW    &kp INSERT     &kp C_AC_REDO   &kp PAGE_UP    &none  &to 0            &to 1      &to 2          &bootloader    &none
&none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &kp HOME        &kp END        &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &none
&none  &kp C_AC_UNDO   &kp C_AC_CUT    &kp C_AC_COPY  &kp C_AC_PASTE  &kp PAGE_DOWN  &none  &none            &none      &none          &none          &none
&none  &none           &none           &none          &none           &none          &none  &none            &none      &none          &none          &none
            >;
        };

        Media {
            display-name = "Media";
            bindings = <
&none  &none         &none              &none         &none         &none           &none  &none            &none      &none          &none          &none
&none  &none         &kp C_VOLUME_UP    &none         &none         &none           &none  &to 0            &to 1      &to 2          &bootloader    &none
&none  &kp C_PREV    &kp C_VOLUME_DOWN  &kp C_NEXT    &none         &none           &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR_ALL  &none  &none            &none      &none          &none          &none
&none  &none         &none              &kp C_MUTE    &kp C_PP      &kp C_STOP      &none  &none            &none      &none          &none          &none
            >;
        };
    };
};
